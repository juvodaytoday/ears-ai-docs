# Copy this file to `.env` in the same folder and fill in your values.
# .env is git-ignored and never committed. Do not share it.

# --- VOXO API ---
# Access token generated from PowerShell (the login/MFA flow).
# It expires; regenerate and paste a fresh value when the script returns 401.
VOXO_API_TOKEN=

# Juvo's tenant ID as a number (e.g. 12345).
VOXO_TENANT_ID=

# Leave default unless VOXO tells you otherwise.
VOXO_API_BASE_URL=https://api.voxo.co

# Which extension types to include. Comma-separated. Default keeps just
# voice extensions (real phones). Others: paging, fax, trunk.
INCLUDE_EXTENSION_TYPES=voice

# --- Email alerts ---
# Recipients for the alert email, comma-separated.
ALERT_RECIPIENTS=l.shea.bo@example.com,shane@example.com

# SMTP relay. For Microsoft 365, use an APP PASSWORD created for this
# script (not your normal M365 password). Same address works for FROM.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
